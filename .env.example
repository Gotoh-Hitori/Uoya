# Copy to .env in this project. Keys are read by the server only.
CHAT_API_PORT=3001
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
AI_MODE=disabled
AI_NAME=AI
AI_TRIGGER_MODE=auto
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=800
# 留空按通道判断；true 启用同一 AI 通道的 Responses web_search
# AI_WEB_SEARCH=true
# AI_API_FORMAT=auto
# Join rules are configured by the space administrator in the app.
COOKIE_SECURE=false
TTS_ENABLED=false
TTS_PROVIDER_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
# Optional legacy AI action bridge uses this port with npm run ai-server.
AI_PORT=8787

# Local LongMemory engine (no API key needed for memory itself)
LONGMEMORY_ENABLED=true
LONGMEMORY_TOP_K=8
LONGMEMORY_TOKEN_BUDGET=1200
# Optional database path; default is beside the chat database.
# LONGMEMORY_DB_PATH=./data/longmemory.sqlite
# LONGMEMORY_SOURCE=LongMemory-main/LongMemory-main

# Life accounts: one-time welcome grant in virtual coins
LIFE_WELCOME_COINS=0
LIFE_AI_WELCOME_COINS=0
# LIFE_DB_PATH defaults to the existing chat SQLite database.

# Production single-entry gateway (npm start)
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# CHAT_API_PORT=3001
# PUBLIC_ORIGIN=https://home.example.com
